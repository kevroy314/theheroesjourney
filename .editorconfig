root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# GDScript is tab-indented by convention and the parser cares.
[*.gd]
indent_style = tab
indent_size = 4

[*.{json,webmanifest,js,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{sh,cfg,godot}]
indent_style = tab
