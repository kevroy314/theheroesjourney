{
  "name": "theheroesjourney",
  "version": "0.2.24",
  "private": true,
  "description": "A life-balance habit app wearing a roguelike as a costume. Godot 4.7, mobile-first, installable as a PWA.",
  "homepage": "https://github.com/kevroy314/theheroesjourney",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevroy314/theheroesjourney.git"
  },
  "author": "Kevin Horecka",
  "license": "UNLICENSED",
  "_comment": [
    "This is a Godot project, not a Node project \u2014 there are no dependencies to install.",
    "package.json exists as a single discoverable entry point for the build commands,",
    "which are all thin shell scripts. Node is only required for the push server (see",
    "server/), which has its own package.json.",
    "The emu:* scripts drive the local Android emulator through the android-device",
    "skill in ~/.claude/skills; they are machine-local, like config.godotBin.",
    "Not here on purpose: `python3 tools/make_world.py` regenerates the world from",
    "scratch and overwrites anything imported from Tiled. It is a real command, but",
    "it is not a convenience, so it does not get a one-word alias."
  ],
  "engines": {
    "godot": "4.7",
    "node": ">=18"
  },
  "scripts": {
    "test": "./test.sh",
    "check": "python3 tools/validate_data.py",
    "verify": "npm run check && npm run test",
    "build": "./run.sh",
    "serve": "./run.sh --no-build",
    "stop": "./stop.sh",
    "fast": "BROTLI_QUALITY=5 ./run.sh",
    "import": "\"${GODOT_BIN:-$npm_package_config_godotBin}\" --headless --path . --import",
    "world:edit": "world/open-in-tiled.sh",
    "world:export": "python3 tools/world_to_tiled.py",
    "world:import": "python3 tools/tiled_to_world.py",
    "world:check": "python3 tools/tiled_to_world.py --check",
    "world:shot": "./tools/worldshot.sh",
    "android": "./build_android.sh",
    "version": "python3 tools/version.py",
    "bump": "python3 tools/version.py --bump",
    "emu:up": "$HOME/.claude/skills/android-device/scripts/up.sh",
    "emu:doctor": "$HOME/.claude/skills/android-device/scripts/doctor.sh",
    "emu:start": "$HOME/.claude/skills/android-device/scripts/avd.sh start heroes-1 5554",
    "emu:fresh": "$HOME/.claude/skills/android-device/scripts/avd.sh reset heroes-1",
    "emu:stop": "$HOME/.claude/skills/android-device/scripts/avd.sh stop heroes-1",
    "emu:install": "$HOME/.claude/skills/android-device/scripts/install.sh heroes",
    "emu:launch": "$HOME/.claude/skills/android-device/scripts/ux.sh app start com.kevinhorecka.heroesjourney",
    "emu:shot": "$HOME/.claude/skills/android-device/scripts/ux.sh shot",
    "emu:ui": "$HOME/.claude/skills/android-device/scripts/ux.sh ui",
    "emu:log": "$HOME/.claude/skills/android-device/scripts/ux.sh log",
    "emu:wipe": "$HOME/.claude/skills/android-device/scripts/ux.sh app clear com.kevinhorecka.heroesjourney",
    "icons": "python3 tools/make_icons.py",
    "tiles": "python3 tools/make_tiles.py && python3 tools/add_prop.py reapply",
    "sprites": "python3 tools/make_sprites.py",
    "export:linux": "mkdir -p build/linux && \"${GODOT_BIN:-$npm_package_config_godotBin}\" --headless --path . --export-release Linux build/linux/heroes.x86_64",
    "selftest:build": "npm run export:linux && ./build/linux/heroes.x86_64 --headless -- --selftest"
  },
  "config": {
    "godotBin": "/home/kevin/godot-tools/Godot_v4.7-stable_linux.x86_64"
  }
}
