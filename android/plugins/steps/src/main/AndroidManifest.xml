<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 29+ gates the hardware step counter behind this runtime permission.
         Declared here as well as in export_presets.cfg so the plugin stays
         self-contained if the preset is ever regenerated. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- required="false": plenty of devices have no pedometer and we degrade
         gracefully rather than being filtered off the Play Store. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <application>

        <!-- Godot's v2 plugin discovery scans the merged manifest for this prefix at
             runtime and instantiates the named class. The suffix after the prefix is
             the singleton name GDScript sees via Engine.get_singleton(). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.HeroesSteps"
            android:value="com.kevinhorecka.heroesjourney.steps.HeroesStepsPlugin" />

    </application>

</manifest>
