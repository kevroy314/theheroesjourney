<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared here rather than only in export_presets.cfg because the permission is
         meaningless without this plugin, and because the preset is regenerated by hand
         often enough that a self-contained AAR is the safer home. It is not a runtime
         permission: it toggles an AppOp the user flips in Settings, and
         PackageManager.canRequestPackageInstalls() returns false forever, with no
         dialog and no error, if it is not declared in the merged manifest. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- API 30+ package-visibility filtering. Nothing here is required to *start* the
         installer, but without it the installer and the Settings screen are invisible to
         any PackageManager query we or a future maintainer might make, which reads as
         "this phone cannot install APKs" when it plainly can. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
    </queries>

    <application>

        <!-- Godot's v2 plugin discovery scans the merged manifest for this prefix at
             runtime and instantiates the named class. The suffix after the prefix is
             the singleton name GDScript sees via Engine.get_singleton(). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.HeroesUpdater"
            android:value="com.kevinhorecka.heroesjourney.updater.HeroesUpdaterPlugin" />

        <!-- The APK has to reach the system installer as a content:// URI; a file://
             one throws FileUriExposedException on API 24+.

             The authority is deliberately NOT "${applicationId}.fileprovider":
             godot-lib.aar already registers a provider under exactly that authority
             (for OS.shell_open), and two providers claiming one authority is
             INSTALL_FAILED_CONFLICTING_PROVIDER at install time: a brick, not a
             warning. ${applicationId} is substituted with the app's real package by
             the manifest merger when this AAR is merged into the export, and
             HeroesUpdaterPlugin rebuilds the same string from context.packageName. -->
        <provider
            android:name="com.kevinhorecka.heroesjourney.updater.HeroesFileProvider"
            android:authorities="${applicationId}.updater.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/heroes_updater_paths" />
        </provider>

    </application>

</manifest>
